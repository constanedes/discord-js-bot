{
    "name": "discord-js-bot",
    "version": "2.0.0",
    "description": "General purpose Discord bot built with TypeScript and discord.js",
    "license": "MIT",
    "author": "Constantino Edes",
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "build": "pnpm clean && tsc",
        "check": "tsc --noEmit",
        "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
        "dev": "tsx watch src/index.ts",
        "format": "oxfmt --write .",
        "format:check": "oxfmt --check .",
        "lint": "oxlint src",
        "start": "node dist/index.js",
        "test": "node --test"
    },
    "dependencies": {
        "@discordjs/voice": "^0.19.2",
        "discord.js": "^14.27.0",
        "dotenv": "^17.2.2",
        "play-dl": "^1.9.7",
        "zod": "^4.1.5"
    },
    "devDependencies": {
        "@types/node": "^24.3.0",
        "oxfmt": "^0.63.0",
        "oxlint": "^1.78.0",
        "tsx": "^4.19.3",
        "typescript": "^5.9.2"
    },
    "engines": {
        "node": ">=22"
    }
}
